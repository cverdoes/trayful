{
  "path": ["packages", "scripts"],
  "pattern": "**/*.{ts,tsx}",
  "ignore": ["**/node_modules/**", "**/dist/**", "packages/*/test/**", "scripts/test/**"],
  "minLines": 8,
  "minTokens": 60,
  "threshold": 1,
  "reporters": ["console", "json"],
  "gitignore": true,
  "output": ".reports/jscpd"
}
