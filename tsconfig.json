{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The example engines import the client as `trayful/engine`, as they would from npm.
    "paths": { "trayful/engine": ["./packages/engine-client/src/index.ts"] }
  },
  "include": [
    "examples/*/*.ts",
    "examples/*/test",
    "packages/*/src",
    "packages/*/test",
    "scripts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["packages/app"]
}
