{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The examples import `trayful/engine` and `trayful/server`, as they would from npm.
    "paths": {
      "trayful/engine": ["./packages/engine-client/src/index.ts"],
      "trayful/server": ["./packages/server/src/public.ts"]
    },
    // Examples run as TypeScript in Node, which needs the `.ts` in their own imports.
    "allowImportingTsExtensions": true
  },
  "include": [
    "examples/*/*.ts",
    "examples/*/test",
    "packages/*/src",
    "packages/*/test",
    "scripts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["packages/app"]
}
