{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Library",
  "$defs": {
    "Library": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "library",
          "description": "Marks this file as a library."
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          },
          "description": "Components defined in this file."
        }
      },
      "required": [
        "kind",
        "components"
      ],
      "additionalProperties": false,
      "title": "Trayful library",
      "description": "Defines components: their size, what they are, how they look and behave."
    },
    "Component": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Unique id of the component within the project. Referenced from the inventory and setups."
        },
        "name": {
          "description": "Display name. Default: the id.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "size": {
          "description": "Width and height in millimetres, or one number for a square.",
          "$ref": "#/$defs/Size"
        },
        "is": {
          "type": "string",
          "enum": [
            "piece",
            "zone",
            "die",
            "counter",
            "stamp"
          ],
          "description": "What the component is on the table."
        },
        "fields": {
          "description": "Per-component data, filled by the inventory and usable as `{{field}}` in faces.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z_]\\w*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          }
        },
        "face": {
          "description": "Its outline and front side.",
          "$ref": "#/$defs/Face"
        },
        "flippable": {
          "description": "Pieces and zones only.",
          "$ref": "#/$defs/Flippable"
        },
        "rotates": {
          "description": "Pieces and zones only.",
          "$ref": "#/$defs/Rotates"
        },
        "stackable": {
          "description": "Pieces and zones only.",
          "$ref": "#/$defs/Stackable"
        },
        "container": {
          "description": "Drop areas: other components dropped there snap to this one and move with it. Pieces and zones only.",
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapTarget"
          }
        },
        "values": {
          "description": "Dice and counters only.",
          "$ref": "#/$defs/Values"
        }
      },
      "required": [
        "id",
        "size",
        "is"
      ],
      "additionalProperties": false,
      "description": "A kind of component: its size, what it is, how it looks and which behaviours it has."
    },
    "Size": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ],
      "description": "A size in millimetres: one number for square or round pieces, or `[width, height]`."
    },
    "Field": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(string|int|number|bool|image|color)\\??$",
          "description": "Shorthand: a field type name, with a trailing `?` when the field is optional."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "description": "Field type. Defaults to `string`, or `enum` when `enum` is given.",
              "type": "string",
              "enum": [
                "string",
                "int",
                "number",
                "bool",
                "image",
                "color"
              ]
            },
            "enum": {
              "description": "Allowed values. Inventory rows must use one of these.",
              "minItems": 1,
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "default": {
              "description": "Value used when a row leaves the field out.",
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "optional": {
              "description": "When true, rows may leave the field out without a default.",
              "type": "boolean"
            },
            "description": {
              "description": "What the field means; shown in the editor and to agents.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Full field definition."
        }
      ],
      "description": "A data field on a component type, filled per component by the inventory. Either a shorthand string such as `\"int\"` or `\"image?\"`, or an object."
    },
    "Face": {
      "type": "object",
      "properties": {
        "shape": {
          "description": "Outline of the component. Default `rect`.",
          "type": "string",
          "enum": [
            "rect",
            "circle",
            "ellipse",
            "hex",
            "triangle",
            "meeple",
            "cube",
            "disc"
          ]
        },
        "corner": {
          "description": "Corner radius in millimetres, for rectangles.",
          "type": "number",
          "minimum": 0
        },
        "fill": {
          "description": "Background colour. `transparent` shows the table through.",
          "$ref": "#/$defs/Color"
        },
        "stroke": {
          "description": "Outline colour.",
          "$ref": "#/$defs/Color"
        },
        "image": {
          "description": "An image covering the face.",
          "$ref": "#/$defs/ImageRef"
        },
        "labels": {
          "description": "Text drawn over the face, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Label"
          }
        },
        "layers": {
          "description": "Advanced: shapes, images and text drawn in order over the image and under the labels.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Layer"
          }
        }
      },
      "additionalProperties": false,
      "description": "How a component looks: its outline and its front side."
    },
    "Color": {
      "type": "string",
      "minLength": 1,
      "description": "A CSS colour (`\"#d94b3d\"`, `\"white\"`, `\"transparent\"`), a colour name from the assets file, or a `{{field}}` template that resolves to one."
    },
    "ImageRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "An image asset by name: the whole image."
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "Name of an image in the assets file."
            },
            "tile": {
              "description": "One tile of a tiled image, counted left to right, then top to bottom, from 0. `instance` lets each component pick its tile with a `tile` value in the inventory; `value` shows the tile of a die or counter value.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "const": "instance"
                },
                {
                  "type": "string",
                  "const": "value"
                }
              ]
            },
            "row": {
              "description": "Row of the tile, from 0. Use with `col`.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "col": {
              "description": "Column of the tile, from 0. Use with `row`.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "fit": {
              "description": "How the image fills the face. Default `cover`.",
              "type": "string",
              "enum": [
                "cover",
                "contain",
                "stretch"
              ]
            }
          },
          "required": [
            "asset"
          ],
          "additionalProperties": false
        }
      ],
      "description": "An image from the assets file: its name for the whole image, or `{ asset, tile }` (or `row` and `col`) for one tile of a tiled image."
    },
    "Label": {
      "type": "object",
      "properties": {
        "text": {
          "description": "Fixed text. May hold `{{field}}` placeholders.",
          "$ref": "#/$defs/Template"
        },
        "field": {
          "description": "A field whose value each component shows. A field the component does not declare becomes a text field.",
          "type": "string",
          "pattern": "^[a-zA-Z_]\\w*$"
        },
        "at": {
          "description": "Position of the layer's anchor, from the face's top-left corner. Default `[0, 0]`.",
          "$ref": "#/$defs/Vec2"
        },
        "rotate": {
          "description": "Rotation in degrees, clockwise.",
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "when": {
          "description": "Only draw this layer when the template resolves to a non-empty value other than `false` or `0`.",
          "$ref": "#/$defs/Template"
        },
        "width": {
          "description": "Wrap width in millimetres. Default: no wrapping.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "align": {
          "description": "Default `left`.",
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "valign": {
          "description": "Default `top`.",
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "font": {
          "type": "object",
          "properties": {
            "size": {
              "description": "Font size in points. Default 10.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "weight": {
              "description": "Default `normal`.",
              "type": "string",
              "enum": [
                "normal",
                "bold"
              ]
            },
            "family": {
              "description": "CSS font family. Default is the app's sans-serif.",
              "type": "string"
            },
            "style": {
              "type": "string",
              "enum": [
                "normal",
                "italic"
              ]
            }
          },
          "additionalProperties": false
        },
        "color": {
          "description": "Text colour. Default black.",
          "$ref": "#/$defs/Color"
        }
      },
      "additionalProperties": false,
      "description": "Text on a face: fixed `text`, or the value of a `field`. Give one of the two."
    },
    "Template": {
      "type": "string",
      "description": "Text that may contain `{{field}}` placeholders, filled in from each component's data."
    },
    "Vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "An `[x, y]` pair in millimetres."
    },
    "Layer": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextLayer"
        },
        {
          "$ref": "#/$defs/ImageLayer"
        },
        {
          "$ref": "#/$defs/ShapeLayer"
        }
      ],
      "description": "One drawing step on a face. Exactly one of `text`, `image` or `shape` decides the kind."
    },
    "TextLayer": {
      "type": "object",
      "properties": {
        "text": {
          "description": "The text to draw. Supports `{{field}}` placeholders.",
          "$ref": "#/$defs/Template"
        },
        "at": {
          "description": "Position of the layer's anchor, from the face's top-left corner. Default `[0, 0]`.",
          "$ref": "#/$defs/Vec2"
        },
        "rotate": {
          "description": "Rotation in degrees, clockwise.",
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "when": {
          "description": "Only draw this layer when the template resolves to a non-empty value other than `false` or `0`.",
          "$ref": "#/$defs/Template"
        },
        "width": {
          "description": "Wrap width in millimetres. Default: no wrapping.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "align": {
          "description": "Horizontal alignment around `at`. Default `left`.",
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "valign": {
          "description": "Vertical alignment around `at`. Default `top`.",
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "font": {
          "type": "object",
          "properties": {
            "size": {
              "description": "Font size in points. Default 10.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "weight": {
              "description": "Default `normal`.",
              "type": "string",
              "enum": [
                "normal",
                "bold"
              ]
            },
            "family": {
              "description": "CSS font family. Default is the app's sans-serif.",
              "type": "string"
            },
            "style": {
              "type": "string",
              "enum": [
                "normal",
                "italic"
              ]
            }
          },
          "additionalProperties": false
        },
        "color": {
          "description": "Text colour. Default black.",
          "$ref": "#/$defs/Color"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "description": "Draws text."
    },
    "ImageLayer": {
      "type": "object",
      "properties": {
        "image": {
          "description": "Path to an image or SVG, relative to the project folder, or a `{{field}}` of type `image`.",
          "$ref": "#/$defs/Template"
        },
        "at": {
          "description": "Position of the layer's anchor, from the face's top-left corner. Default `[0, 0]`.",
          "$ref": "#/$defs/Vec2"
        },
        "rotate": {
          "description": "Rotation in degrees, clockwise.",
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "when": {
          "description": "Only draw this layer when the template resolves to a non-empty value other than `false` or `0`.",
          "$ref": "#/$defs/Template"
        },
        "size": {
          "description": "Drawn size. Default: the whole face.",
          "$ref": "#/$defs/Size"
        },
        "fit": {
          "description": "How the image fills `size`. Default `cover`.",
          "type": "string",
          "enum": [
            "cover",
            "contain",
            "stretch"
          ]
        }
      },
      "required": [
        "image"
      ],
      "additionalProperties": false,
      "description": "Draws an image file."
    },
    "ShapeLayer": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "rect",
            "circle",
            "ellipse",
            "hex",
            "triangle",
            "meeple",
            "cube",
            "disc"
          ],
          "description": "The shape to draw."
        },
        "at": {
          "description": "Position of the layer's anchor, from the face's top-left corner. Default `[0, 0]`.",
          "$ref": "#/$defs/Vec2"
        },
        "rotate": {
          "description": "Rotation in degrees, clockwise.",
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "when": {
          "description": "Only draw this layer when the template resolves to a non-empty value other than `false` or `0`.",
          "$ref": "#/$defs/Template"
        },
        "size": {
          "description": "Bounding size. Use this or `r`.",
          "$ref": "#/$defs/Size"
        },
        "r": {
          "description": "Radius, for circles and hexes. `at` is then the centre.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fill": {
          "$ref": "#/$defs/Color"
        },
        "stroke": {
          "$ref": "#/$defs/Color"
        },
        "strokeWidth": {
          "description": "Outline width in millimetres.",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "shape"
      ],
      "additionalProperties": false,
      "description": "Draws a filled or outlined shape."
    },
    "Flippable": {
      "anyOf": [
        {
          "type": "boolean",
          "const": true
        },
        {
          "type": "object",
          "properties": {
            "back": {
              "description": "How the back looks. Default: a plain back.",
              "$ref": "#/$defs/Back"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "The component has a back and can be turned over."
    },
    "Back": {
      "type": "object",
      "properties": {
        "fill": {
          "description": "Background colour. `transparent` shows the table through.",
          "$ref": "#/$defs/Color"
        },
        "stroke": {
          "description": "Outline colour.",
          "$ref": "#/$defs/Color"
        },
        "image": {
          "description": "An image covering the face.",
          "$ref": "#/$defs/ImageRef"
        },
        "labels": {
          "description": "Text drawn over the face, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Label"
          }
        },
        "layers": {
          "description": "Advanced: shapes, images and text drawn in order over the image and under the labels.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Layer"
          }
        }
      },
      "additionalProperties": false,
      "description": "The back of a flippable component. It has the front's outline. Fields it uses are shown to everyone while the component lies face down."
    },
    "Rotates": {
      "anyOf": [
        {
          "type": "boolean",
          "const": true
        },
        {
          "type": "object",
          "properties": {
            "step": {
              "description": "Degrees per turn. Default 90.",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 360
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "The component can be turned on the table."
    },
    "Stackable": {
      "anyOf": [
        {
          "type": "boolean",
          "const": true
        },
        {
          "type": "object",
          "properties": {
            "with": {
              "description": "Other components it may share a stack with. It always stacks with itself.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Components of this kind pile up into stacks, like decks."
    },
    "SnapTarget": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Name of the drop area, used in setups and by agents as `component/area/index`."
        },
        "accepts": {
          "description": "Component ids, or representations (`piece`, `zone`, `die`, `counter`), that may snap here. Default: anything. In `stamp` mode: the stamps that may be pressed here (default: every stamp).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grid": {
          "description": "A regular grid of spots, numbered left to right, then top to bottom, from 0. In `stamp` and `text` mode each spot is a box the size of a cell.",
          "type": "object",
          "properties": {
            "origin": {
              "description": "Centre of the first cell.",
              "$ref": "#/$defs/Vec2"
            },
            "cols": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "rows": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cell": {
              "description": "Distance between cell centres.",
              "$ref": "#/$defs/Size"
            }
          },
          "required": [
            "origin",
            "cols",
            "rows",
            "cell"
          ],
          "additionalProperties": false
        },
        "points": {
          "description": "An ordered list of spots, such as a score track. In `stamp` mode each spot is as large as its largest stamp; in `text` mode, 10 mm square.",
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Vec2"
          }
        },
        "area": {
          "description": "An area: components dropped inside it stay in it, as its `mode` says.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Top-left corner.",
              "$ref": "#/$defs/Vec2"
            },
            "size": {
              "$ref": "#/$defs/Size"
            }
          },
          "required": [
            "at",
            "size"
          ],
          "additionalProperties": false
        },
        "mode": {
          "description": "What the drop area does with what is dropped in it. Spots (`grid`, `points`): `single` (default) holds one thing per spot; `pile` piles everything dropped on a spot into one stack, like a discard pile; `group` keeps everything dropped on a spot as separate pieces side by side, like score markers sharing a space, so any one can be picked up; `stamp` takes no pieces, but each spot can be marked with one of the stamps it accepts, like ticking a box on a score sheet; `text` takes no pieces either, but each spot holds text that players write in. Areas: `free` (default) leaves things where they are dropped; `row` lines them up side by side, left to right; `bag` hides them from everyone, to be drawn at random.",
          "type": "string",
          "enum": [
            "single",
            "pile",
            "group",
            "stamp",
            "text",
            "free",
            "row",
            "bag"
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "description": "A drop area of a container: where other components snap when dropped on it. Give exactly one of `grid`, `points` or `area`."
    },
    "Values": {
      "type": "object",
      "properties": {
        "range": {
          "description": "`[min, max]`: every whole number from min to max.",
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "list": {
          "description": "The values in order, e.g. `[sword, shield, sword, skull, blank, blank]`.",
          "minItems": 2,
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "controls": {
          "description": "`roll` picks a random value, `step` goes up or down. Default: `roll` for dice, `step` for counters.",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "roll",
              "step"
            ]
          }
        }
      },
      "additionalProperties": false,
      "description": "The values of a die or counter: a `range` or a `list`. Default `range: [1, 6]` for dice and `range: [0, 99]` for counters."
    }
  },
  "$id": "https://github.com/cverdoes/trayful/blob/main/packages/formats/schema/library.schema.json"
}
